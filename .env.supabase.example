# ---------------------------------------------------------------
# Copy these values into your Laravel ".env" file (replace the DB_ lines).
# NEVER commit ".env" or share your real password.
# ---------------------------------------------------------------
APP_NAME="Opusio"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# --- Supabase PostgreSQL --------------------------------------------------
# Supabase dashboard > your project > "Connect" button > "Session pooler"
DB_CONNECTION=pgsql
DB_HOST=aws-0-YOUR-REGION.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=YOUR_DATABASE_PASSWORD
DB_SSLMODE=require

# --- Sessions in the database so logins survive restarts / redeploys ------
#     (the migration creates the "sessions" table if it is missing)
SESSION_DRIVER=database
CACHE_STORE=file
QUEUE_CONNECTION=sync
